{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "types": ["node"], "sourceMap": true, "inlineSources": true,
    "declaration": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
