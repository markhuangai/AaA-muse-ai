{
  "name": "@aaa-muse/portal",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "vite build --outDir dist",
    "test:unit": "vitest run --environment jsdom --coverage --coverage.provider v8 --coverage.include 'src/**/*.{ts,tsx}' --coverage.reporter json --coverage.reporter text --coverage.reportsDirectory ../.artifacts/unit/portal"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
